{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID matching auth.uid", "maxLength": 128 },
        "email": { "type": "string", "description": "User email address", "maxLength": 256 },
        "displayName": { "type": "string", "description": "Display name of the user", "maxLength": 128 },
        "photoURL": { "type": "string", "description": "Avatar URL", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat session owned by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique chat ID", "maxLength": 128 },
        "title": { "type": "string", "description": "Title of the chat session", "maxLength": 150 },
        "ownerId": { "type": "string", "description": "UID of the owner", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "title", "ownerId", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID", "maxLength": 128 },
        "chatId": { "type": "string", "description": "Parent chat ID", "maxLength": 128 },
        "role": { "type": "string", "description": "Message author role", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "description": "Text content of the message", "maxLength": 50000 },
        "senderId": { "type": "string", "description": "UID of author", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time", "description": "Message creation timestamp" }
      },
      "required": ["id", "chatId", "role", "content", "senderId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Top-level chat sessions created by authenticated users"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages belonging to a chat"
    }
  }
}
